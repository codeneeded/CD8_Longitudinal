.Rproj.user
.Rhistory
.RData
.Ruserdata
saved_R_data

# Raw sequencing data — never committed (deposited at GEO instead)
fastq_raw/
*.fastq
*.fastq.gz
*.fq.gz
*.bam
*.bam.bai
*.cram

# Cell Ranger output — lives outside the repo, but guard against a stray copy
cellranger_out/
*_multi_out/
*.cloupe
*.vloupe
*.h5
*.mtx.gz

# Local R library / environment scratch
.Rlib_*/
renv/library/
.Rproj.user/

# Sandbox-only script variants (shimmed for a conda env; not for production use)
Scripts/CP018 - FACTseq/_sandbox_runs/

# Pipeline run traces — regenerated by run_pipeline.sh, contain absolute local
# paths and package chatter. Not results.
Analysis/*/logs/
# The per-lineage subset runs write their traces beside the results rather than
# in a logs/ folder, so the rule above misses them.
Analysis/*/_run.log
Analysis/*/_annot.log

# Backups left by the in-place script patchers (source-data shim, Seurat 5
# argument fix). These are sandbox variants of files already tracked, so
# committing them would put two versions of each figure script in the repo.
*.R.bak
*.R.preSeurat5.bak

# Deliverables and correspondence live OUTSIDE the repo, in
# ~/Desktop/Projects/Deliverables/. This repo is the manuscript: code, figures,
# tables and analysis notes only.
*_collaborator_email*
*_report.pdf
build_email.py
verify_claims.py

# The reviewer-response package is sent to the editor BY EMAIL and must never
# reach GitHub. These normally live in ~/Desktop/Projects/Deliverables/CP018/,
# outside this repo — these rules exist so that a stray copy dropped in the
# repo cannot be committed by accident. Named explicitly rather than as a
# blanket *.docx/*.pdf, because Manuscript/ legitimately holds figure PDFs and
# Analysis/ holds tracked reports.
TARA_Response_to_Reviewers*
TARA_Manuscript_REVISED*
TARA_Revised_Figures*
TARA_R1M3_HIV_detection*
# The source-data workbook is a compiled deliverable that ships with the email.
# The per-panel CSVs it is built from DO stay in the repo, under
# Manuscript/*/source_data/ — that is what the response points reviewers at.
TARA_SourceData.xlsx

# R writes Rplots.pdf whenever a base-graphics device is opened without a
# filename. It is a side effect of running the figure scripts, not an output.
Rplots.pdf
**/Rplots.pdf

# Python bytecode cache, written whenever a script in Scripts/ is imported
# rather than run. Language debris, not analysis.
__pycache__/
**/__pycache__/
*.pyc
